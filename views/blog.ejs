<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Blog</title>
    <link href="/Lab9/blog.css" rel="stylesheet">
</head>

<body>
    <div class="conteudo">
        <h1>Blog</h1>

        <form action="/cadastrar_post" method="get">
            <input type="submit" value="Criar novo post">
        </form>

        <% if (erro) { %>
            <p class="erro"><%= erro %></p>
        <% } %>

        <% if (posts.length == 0) { %>
            <p>Nenhum post cadastrado ainda.</p>
        <% } %>

        <% for (var i = 0; i < posts.length; i++) { %>
            <div class="post">
                <h2><%= posts[i].db_titulo %></h2>
                <p class="resumo"><%= posts[i].db_resumo %></p>
                <p><%= posts[i].db_conteudo %></p>
            </div>
        <% } %>

        <a href="/Aula2/projects.html">Voltar para Projetos</a>
    </div>
</body>

</html>
